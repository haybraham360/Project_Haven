# Project Haven — environment variables (Phase 1).
# Copy to .env.local and fill in values from your Supabase DEVELOPMENT project.
# Never commit real values. Keep development, staging and production separate.

# Public origin of this app. Used for email links and redirects (never the
# request Host header). Must also be in Supabase Auth > URL Configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and PUBLISHABLE key (Settings > API Keys).
# These are safe in the browser; access is limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# --- Tests only (not used by the app) --------------------------------------
# Postgres connection string for `pnpm test:db`. Use a development or
# throwaway database ONLY — the tests create and delete synthetic users.
# `pnpm test:db:local` does not need this; it uses a local PostgreSQL.
# TEST_DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
